unit uUsuarios;



interface



uses

  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,

  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, JvExStdCtrls, JvEdit,

  JvExControls, JvLabel, JvCombobox, Vcl.Grids, JvExGrids, JvGrids, Vcl.Buttons,

  JvExButtons, JvBitBtn,

  //unit de definição de dados

  Data.DB

  ;



type

  TfrmUsuarios = class(TForm)

    lblNome: TJvLabel;

    edtNome: TJvEdit;

    lblLogin: TJvLabel;

    edtLogin: TJvEdit;

    JvLabel1: TJvLabel;

    edtSenha: TJvEdit;

    cboTipo: TJvComboBox;

    lblTipo: TJvLabel;

    btnCadastrar: TJvBitBtn;

    btnAtualizar: TJvBitBtn;

    JvBitBtn2: TJvBitBtn;

    gridUsuarios: TJvDrawGrid;

    procedure btnCadastrarClick(Sender: TObject);

    procedure gridUsuariosDrawCell(Sender: TObject; ACol, ARow: LongInt;

      Rect: TRect; State: TGridDrawState);

    procedure FormShow(Sender: TObject);

    procedure gridUsuariosSelectCell(Sender: TObject; ACol, ARow: LongInt;

      var CanSelect: Boolean);

    procedure btnAtualizarClick(Sender: TObject);



  private

    { Private declarations }

    FIdSelecionado: integer;



  public

    { Public declarations }

    procedure AtualizarGrid;

  end;



var

  frmUsuarios: TfrmUsuarios;



implementation









{$R *.dfm}



uses uDmDados;



procedure TfrmUsuarios.AtualizarGrid;

   begin



     dtmDados.qryUsuarios.Close;

     dtmDados.qryUsuarios.SQL.Text := 'SELECT * FROM dbo.usuarios';

     dtmDados.qryUsuarios.Open;



     {

       diferente de uma DBGrid o JvDrawGrid exisge qua passe os parametros

       de foma explicita

     }



     gridUsuarios.ColCount := 5;  //infomando 5 colunas 4 para o rgistro  e uma parar o cabeçalho

     gridUsuarios.RowCount := dtmDados.qryUsuarios.RecordCount + 1; // difinido o contador de regitros

     gridUsuarios.Invalidate; //forcanddo odesenho da tabela

















   end;







procedure TfrmUsuarios.btnCadastrarClick(Sender: TObject);

begin



  {validdando os campos que seram enviados para o banco }

  if ( edtNome.Text = ''  ) or ( edtLogin.Text = '') or(edtSenha.Text = '') then

   begin

       ShowMessage('por favor preenceha todos os dados');

       Exit;

   end;



   {tentando registrar depois da validação}



   try

        { preparando a query }



        dtmDados.qryUsuarios.Close;  //fechando qualquer conexão existente

        dtmDados.qryUsuarios.SQL.Clear; //limpando qualquer instrçao sql do componente

        dtmDados.qryUsuarios.SQL.Add('INSERT INTO dbo.usuarios(usuario_nome, usuario_login, usuario_senha, usuario_tipo)'); //parte 1 do insert contendo os campos

        dtmDados.qryUsuarios.SQL.Add('VALUES (:nome, :login, :senha, :tipo)'); //parte 2 do insert contendo os valores dos campos



        // Define explicitamente o tipo dos parâmetros como String (ftString ou ftWideString)

        dtmDados.qryUsuarios.Parameters.ParamByName('nome').DataType  := ftString;

        dtmDados.qryUsuarios.Parameters.ParamByName('login').DataType := ftString;

        dtmDados.qryUsuarios.Parameters.ParamByName('senha').DataType := ftString;

        dtmDados.qryUsuarios.Parameters.ParamByName('tipo').DataType  := ftString;



        {passando os pararmetros da tela para a instrução sql

         Nesse caso eu acesso as variveis que eu cria na query acima

         e faço um preechimento usando os valores vindos nos Text dos campos

        }



        dtmDados.qryUsuarios.Parameters.ParamByName('nome').Value := edtNome.Text;

        dtmDados.qryUsuarios.Parameters.ParamByName('login').Value := edtLogin.Text;

        dtmDados.qryUsuarios.Parameters.ParamByName('senha').Value := edtSenha.Text;



        {

          so vou ter 2 tipos de usuario dentro do projeto

          GESTOR 1

          USUARIO 2

        }

        if (cboTipo.Text = 'GESTOR') then

          begin

             dtmDados.qryUsuarios.Parameters.ParamByName('tipo').Value := 1;

          end

        else

           begin

             dtmDados.qryUsuarios.Parameters.ParamByName('tipo').Value := 2;

           end;









        {executando a querye que foi preparada}



        dtmDados.qryUsuarios.ExecSQL;

        ShowMessage('Usuário cadastrado com sucesso!');

        AtualizarGrid;



        // Limpa os campos da tela



        edtNome.Clear;

        edtLogin.Clear;

        edtSenha.Clear;

        edtNome.SetFocus;



        //se der alguma excessão eu mando mensagem pra tela

     except

        on E: Exception do

            ShowMessage('Erro ao cadastrar usuário: ' + E.Message);

     end;





   end;













procedure TfrmUsuarios.FormShow(Sender: TObject);

begin

   AtualizarGrid;

end;



procedure TfrmUsuarios.gridUsuariosDrawCell(Sender: TObject; ACol,

  ARow: LongInt; Rect: TRect; State: TGridDrawState);



  var Texto:string;



begin



  // 1 essa e alinha zero senria a linha de cabeçalho

  if Arow = 0 then

   begin



       case Acol of

           0: Texto :='ID';

           1: Texto := 'Nome';

           2: Texto := 'Login';

           3: Texto := 'Senha';

           4: Texto := 'Tipo';

       end;



       //personalizando o bg do cabeçalho

       gridUsuarios.Canvas.Brush.Color := clBtnFace;

       gridUsuarios.Canvas.FillRect(Rect);

       gridUsuarios.Canvas.Font.Style := [fsBold];

       gridUsuarios.Canvas.TextOut(Rect.Left + 4, Rect.Top + 4,Texto);

       Exit;

   end;



   // 2. Linhas de dados (Arow > 0 )

   if not dtmDados.qryUsuarios.IsEmpty then



   begin



     //colocando o ponteio do dataseet na linha



     dtmDados.qryUsuarios.RecNo := ARow;



     //pega o valor do campo conforme a coluna



     case Acol of

       0: Texto := dtmDados.qryUsuarios.FieldByName('usuarioId').AsString;

       1: Texto := dtmDados.qryUsuarios.FieldByName('usuario_nome').AsString;

       2: Texto := dtmDados.qryUsuarios.FieldByName('usuario_login').AsString;

       3: Texto := dtmDados.qryUsuarios.FieldByName('usuario_senha').AsString;

       4: Texto := dtmDados.qryUsuarios.FieldByName('usuario_tipo').AsString;

     end;



     //destaca a linha selecionada

     if gdSelected in State then

     begin



        gridUsuarios.Canvas.Brush.Color := clHighlight;

        gridUsuarios.Canvas.Font.Color  := clHighlightText;



     end

     else

      begin

         gridUsuarios.Canvas.Brush.Color := clWindow;

         gridUsuarios.Canvas.Font.Color  := clWindowText;

      end;



      //desenha o fundo e escreve o texto dentro da celula

      gridUsuarios.Canvas.FillRect(Rect);

      gridUsuarios.Canvas.TextOut(Rect.Left + 4, Rect.Top + 4, Texto);



   end;

 end;



{

  Atualização parte 1

  Esse codigo vai pegar os dados que estão na linha selecionada

}

procedure TfrmUsuarios.gridUsuariosSelectCell(Sender: TObject; ACol,

  ARow: LongInt; var CanSelect: Boolean);



begin



   // como a linha zero e o cabeçalho os dados estaão aparecendo apartirr da linha 1



   dtmDados.qryUsuarios.RecNo := Arow; //pegando o id que esta na celula

   edtNome.Text := dtmDados.qryUsuarios.FieldByName('nome').AsString;

   edtNome.Text := dtmDados.qryUsuarios.FieldByName('login').AsString;

   edtNome.Text := dtmDados.qryUsuarios.FieldByName('tipo').AsString;



   //passando o id do usuarios selecionado pra uma varivel privada



   FIdSelecionado := dtmDados.qryUsuarios.FieldByName('id').AsInteger;







end;



{

 Atuaização parte 2

 Executando a o SQL que vai gravar a atualização

}

procedure TfrmUsuarios.btnAtualizarClick(Sender: TObject);

  begin



     //tendo certeza de que houve a seleção

    //testando se a linha selecionada é menor ou igual a zer



    if FIdSelecionado <= 0 then

      begin



        ShowMessage('Seleciona um usuário na tabela pra atualizar');

        Exit;



      end;



    //validando os campos

    //testado sem espços



    if Trim(edtNome.Text) = '' then

        begin



           ShowMessage('Informe o nome do usuário ');

           edtNome.SetFocus;

           Exit;



        end;



      //fazendo o UPDATE de fato

      try

      

        dtmDados.qryUsuarios.Close;

        dtmDados.qryUsuarios.SQL.Clear;

        

        //atualizando nome eo login 



        dtmDados.qryUsuarios.SQL.Add('UPDATE usuarios SET');

        dtmDados.qryUsuarios.SQL.Add(' nome = :nome ,  ');

        dtmDados.qryUsuarios.SQL.Add(' login = :login, ');



        //se asneha não estiver vazia altera ela também

         

        if Trim(edtSenha.Text) <> '' then

          dtmDados.qryUsuarios.SQL.Add('senha = :senha ,');



        

        dtmDados.qryUsuarios.SQL.Add(' tipo = :tipo ');



        //altera com base no id

        

        dtmDados.qryUsuarios.SQL.Add(' WHERE id = :id ');



        // preenchendo as veriáveis da query com os dados do formulario



       dtmDados.qryUsuarios.Parameters.ParamByName('nome').Value.AsString := edtNome.Text;

       dtmDados.qryUsuarios.Parameters.ParamByName('login').Value := edtLogin.Text;



       if Trim( edtSenha.Text ) <> '' then

           dtmDados.qryUsuarios.Parameters.ParamByName('senha').Value := edtSenha.Text;



       dtmDados.qryUsuarios.Parameters.ParamByName('tipo').Value := cboTipo.Text;

       dtmDados.qryUsuarios.Parameters.ParamByName('id').Value.AsInteger := FIdSelecionado;



       dtmDados.qryUsuarios.ExecSQL;



       ShowMessage('Usuário atualizado com sucesso!');



       //recarregando a busca

       dtmDados.qryUsuarios.Close;

       dtmDados.qryUsuarios.Open;



       //Recarreganod o grid 

       gridUsuarios.Invalidate;



       //limpa a seleção e os campos 

       FIdSelecionado := 0;

       edtNome.Clear;

       edtLogin.Clear;

       edtSenha.Clear; 

       

      except

          on E: Exception do

            ShowMessage('Erro ao atualizar: ' + E.Message);

      end;

      

   end;



end. 


